# ============================================================
#  真实数据绝不进版本库 —— 本仓库是公开的
#  数据库里是真实同事的姓名与主观评价,泄漏后果不可逆
# ============================================================
data/
backups/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 密钥与本地配置
.env
.env.*
!env.example
config.local.py
secrets.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 运行时产物
*.log
*.err

# 提交信息草稿(scp 过来的临时文件,别被 git add -A 顺手带走)
_msg.txt
_*.txt

# 本地临时检查脚本。「_」开头 = 只在开发机上跑,不进仓库。
# 这条约定以前只靠自觉维持,结果误提交过文件。写下来。
# (进仓库的测试是 selftest.py 和 fittest.js。)
_*.py
_*.js
